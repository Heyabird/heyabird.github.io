{ "type": "Feature", "properties": { "fid": 6, "target_key": "MICROSOFT", "target_name": "Redmond WA USA", "target_lat": 47.674, "target_lon": -122.1215, "source_url": "https://restofworld.org/2025/brazil-indigenous-group-sues-tiktok-data-center/", "source_place": "Quilicura", "source_country": "Chile", "source_lat": -33.35908071163842, "source_lon": -70.72940030449206, "target_key_2": "MICROSOFT", "empire_frame": "Silicon Valley / US tech", "evidence_summary": "Microsoft had received government clearance in 2023 for a $317-million data center in Quilicura. The company claimed its data center would have a cooling system that would eliminate the need to use water for more than half the year. In documents submitted to authorities, however, Vallejos found that Microsoft’s cooling system would rely partially on groundwater in an already water-stressed area.", "body_type": "water", "source_url_2": "https://restofworld.org/2026/ai-pushback-chile-mexico-kenya-philippines/", "year": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.1215, 47.674 ], [ -114.385209277645586, 40.594108672283859 ], [ -108.169284788555487, 33.087928826546062 ], [ -102.946857629652953, 25.311900800822166 ], [ -98.360650991499995, 17.365099815967167 ], [ -94.157874415789877, 9.315573766763428 ], [ -90.144885442747864, 1.215119322455572 ], [ -86.155881904568105, -6.891779364523392 ], [ -82.028503856050321, -14.961526615005663 ], [ -77.580294126529424, -22.945290408302846 ], [ -72.580155480054884, -30.781093657317363 ], [ -70.72940030449206, -33.35908071163842 ] ] ] } },
{ "type": "Feature", "properties": { "fid": 7, "target_key": "MICROSOFT", "target_name": "Redmond WA USA", "target_lat": 47.674, "target_lon": -122.1215, "source_url": "https://restofworld.org/2025/brazil-indigenous-group-sues-tiktok-data-center/", "source_place": "Amsterdam", "source_country": "Netherlands", "source_lat": 52.376256476946679, "source_lon": 4.8957969676833519, "target_key_2": "MICROSOFT", "empire_frame": " Silicon Valley / US Tech", "evidence_summary": "electricity", "body_type": "More than 500 people have joined a campaign to stop a huge data centre being built in Amsterdam-Zuid, arguing that it will bring “zero benefits to the area”. ... The Dutch government has introduced restrictions on the size of data centres in recent years following criticism from provincial and municipal governments about the strain on the electricity network. Data centres accounted for 4.6% of all electricity use in the Netherlands in 2024.", "source_url_2": "https://www.dutchnews.nl/2026/08/campaigners-call-for-amsterdam-to-pull-plug-on-giant-data-centre/", "year": 2026 }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.1215, 47.674 ], [ -114.01317936119203, 55.109681457327049 ], [ -102.442753847722685, 61.761372857715202 ], [ -85.417646708341337, 66.944753640468576 ], [ -62.103779813761669, 69.517815994925456 ], [ -37.06077348862874, 68.523186349786329 ], [ -17.029818947926955, 64.372261350803868 ], [ -3.224347148614171, 58.278498230813497 ], [ 4.895796967683352, 52.376256476946679 ] ] ] } },
{ "type": "Feature", "properties": { "fid": 8, "target_key": "CLOUDFACTORY", "target_name": "Reading UK", "target_lat": 51.448952803148565, "target_lon": -0.97803143016166838, "source_url": "https://restofworld.org/2026/ai-pushback-chile-mexico-kenya-philippines/", "source_place": "Nairobi", "source_country": "Kenya", "source_lat": -1.2937665993875402, "source_lon": 36.82208838478418, "target_key_2": "CLOUDFACTORY", "empire_frame": null, "evidence_summary": "In eight years of working data annotation jobs at different companies, Kinyua experienced low pay, exploitative conditions, a lack of labor protections, and gender and class biases, she said. That led her to set up the Data Labelers Association with nine others last year, to push for ethical labor standards, and for the invisible workforce powering AI to be recognized, respected, and protected, she said. DLA advocates for fair pay, transparency, and accountability from companies and the government.", "body_type": "labor", "source_url_2": "https://restofworld.org/2026/ai-pushback-chile-mexico-kenya-philippines/", "year": 2026 }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -0.978031430161668, 51.448952803148565 ], [ 7.815822976895457, 44.641434342073801 ], [ 14.699871950308609, 37.293455639995784 ], [ 20.333813677012873, 29.607905160861854 ], [ 25.159614454623139, 21.708338502050406 ], [ 29.479396141041441, 13.67544317906399 ], [ 33.513049984599192, 5.567066290966795 ], [ 36.82208838478418, -1.29376659938754 ] ] ] } },
{ "type": "Feature", "properties": { "fid": 9, "target_key": "STARGATE", "target_name": "San Francisco CA USA", "target_lat": 37.773228331006479, "target_lon": -122.41736575987626, "source_url": "https://www.projectcensored.org/communities-against-ai-data-center/", "source_place": "Tucson, Arizona", "source_country": "USA", "source_lat": 32.241034323555468, "source_lon": -110.96826853718642, "target_key_2": "STARGATE", "empire_frame": "Silicon Valley / US tech", "evidence_summary": "The Earth Island Institute writes about resistance in Tucson, Arizona, where a proposal for “Project Blue,” put forth by Beale Infrastructure, would take millions of gallons of drinking water from the desert for cooling purposes. Residents consistently attended town board meetings and wrote numerous emails and op-eds in local newspapers. “I feel like I learned more about Project Blue from the public than the city,” said city councilman Rocque Perez, revealing how concerned citizens take it upon themselves to communicate with each other and fill local news deserts. The Guardian reported that “on 6 August, in an unscheduled vote, council members unanimously decided to discontinue discussions with Beale, each sharing short speeches revealing sharp opposition to Project Blue. Tucsonans packing the council chambers cheered and celebrated; Beale executives, appearing stunned, were booed as they left.” Project Blue no longer.", "body_type": "water", "source_url_2": "https://www.projectcensored.org/communities-against-ai-data-center/", "year": 2026 }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.417365759876262, 37.773228331006479 ], [ -112.850705823814039, 33.278713606269719 ], [ -110.968268537186418, 32.241034323555468 ] ] ] } },
{ "type": "Feature", "properties": { "fid": 10, "target_key": "TERAWULF", "target_name": "Easton Maryland", "target_lat": 38.771850462513321, "target_lon": -76.071986527140922, "source_url": "https://www.projectcensored.org/communities-against-ai-data-center/", "source_place": "Lansing New York", "source_country": "USA", "source_lat": 42.485619970560009, "source_lon": -76.48451248136972, "target_key_2": "TERAWULF", "empire_frame": "US tech", "evidence_summary": "Terawulf, a Maryland-based technology company, has proposed converting an old coal power plant on Cayuga Lake in Lansing, New York, into a large-scale AI data center. ... Critics of the data center have shown up at Lansing town board meetings, citing environmental concerns, including noise pollution and the proposed use of Cayuga Lake water for cooling. Much of the investigative reporting on the proposed data center has been conducted by local outlets, such as the Ithaca Voice and Ithaca Times, and other independent investigative organizations.", "body_type": "https://www.projectcensored.org/communities-against-ai-data-center/", "source_url_2": "2026", "year": null }, "geometry": { "type": "MultiLineString", "coordinates": [ ] } },
{ "type": "Feature", "properties": { "fid": 11, "target_key": "xAI", "target_name": "Palo Alto CA USA", "target_lat": 37.439816661634666, "target_lon": -122.1456441546385, "source_url": " https://time.com/7308925/elon-musk-memphis-ai-data-center/", "source_place": "Boxtown, Tennessee", "source_country": "USA", "source_lat": 35.047482905781763, "source_lon": -90.124302573915514, "target_key_2": "xAI", "empire_frame": "Silicon Valley / US tech", "evidence_summary": "Environmentalists and community activists say this is no coincidence. Boxtown, a predominantly Black community with a median income of $37,000, sits a few miles from where Musk, driven by ambitions of creating an AI smarter than humans, set up the self-proclaimed biggest supercomputer in the world last year.  ... But all of those computers need a vast amount of energy to run. Fueling them has been 35 unpermitted temporary gas turbines, which have been pumping out a level of emissions that, according to environmentalists, is exacerbating the health issues of an area already crushed by decades of pollution.", "body_type": "https://time.com/7308925/elon-musk-memphis-ai-data-center/", "source_url_2": "2025", "year": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.145644154638504, 37.439816661634666 ], [ -110.82835347721344, 37.604940252892177 ], [ -99.623173887158941, 36.691246625294703 ], [ -90.124302573915514, 35.047482905781763 ] ] ] } },
{ "type": "Feature", "properties": { "fid": 12, "target_key": "AMAZON", "target_name": "Seattle WA USA", "target_lat": 47.622339539070765, "target_lon": -122.33942066158424, "source_url": "https://www.politico.eu/article/artificial-intelligence-threat-raid-water-reserves-europe-dry-regions/", "source_place": "Zarazoga", "source_country": "Spain", "source_lat": 41.653760476606841, "source_lon": -0.88798146111879928, "target_key_2": "AMAZON", "empire_frame": "Silicon Valley / US tech", "evidence_summary": "While the likes of Amazon promise more than €15 billion of investment, jobs, partnerships with local schools, community education programs, water infrastructure updates and 'sustainability initiatives,' grassroots groups are springing up, wary of tech giants muscling in on their water resources. ... “In the end the farmer never wins,” said ‍Chechu Sánchez, an Aragonese farmer speaking at an event on data centers in Zaragoza, Aragon’s capital. “Whenever there is plunder by foreign capital, the farmer, the people of the municipalities — we never win, we don’t benefit at all.” ... Activist Aurora Gómez and her collective Tu Nube Seca Mi Río (which translates as “your cloud is drying up my river”) is heading up a campaign for a moratorium on all new data centers in Spain. Farmers, Europe’s most prolific water users, are among the most vulnerable, said Gómez, and — when they find out about the data centers’ water usage — the most incensed.", "body_type": "water", "source_url_2": "https://www.politico.eu/article/artificial-intelligence-threat-raid-water-reserves-europe-dry-regions/", "year": 2026 }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.339420661584242, 47.622339539070765 ], [ -112.345002226954037, 54.027292767034027 ], [ -99.102529011495534, 59.314607639225628 ], [ -81.976864524848224, 62.822961852364713 ], [ -62.062192837361287, 63.827120968628108 ], [ -42.671608787265214, 62.055946052896999 ], [ -26.64000863685051, 57.966339151203378 ], [ -14.414468016229122, 52.305481922889548 ], [ -5.157966819959924, 45.672292941823883 ], [ -0.887981461118799, 41.653760476606841 ] ] ] } },
{ "type": "Feature", "properties": { "fid": 14, "target_key": "GOOGLE", "target_name": "Mountain View CA USA", "target_lat": 37.427644980574435, "target_lon": -122.0954258034336, "source_url": " https://www.reuters.com/world/asia-pacific/googles-15-billion-india-data-centre-project-battles-water-wildlife-concerns-2026-08-06/", "source_place": "Visakhapatnam", "source_country": " India", "source_lat": 17.734395519838074, "source_lon": 83.309411863246908, "target_key_2": "GOOGLE", "empire_frame": "Silicon Valley / US tech", "evidence_summary": "Work to build Google's planned Indian data centre hub is in full swing, with a ​hillside above the site stripped to red earth and terraced into steps, but mounting opposition from environmentalists is creating hurdles for the U.S. tech ‌giant's $15 billion project. ... The southern state of Andhra Pradesh, governed by an ally of Prime Minister Narendra Modi who has hailed the project as historic and transformational, has denied allegations that the project was fast-tracked without weighing risks to water supplies and wildlife.", "body_type": "water", "source_url_2": "https://www.reuters.com/world/asia-pacific/googles-15-billion-india-data-centre-project-battles-water-wildlife-concerns-2026-08-06/", "year": 2026 }, "geometry": { "type": "MultiLineString", "coordinates": [ ] } },
{ "type": "Feature", "properties": { "fid": 15, "target_key": "META", "target_name": "Menlo Park CA USA", "target_lat": 37.484643850872629, "target_lon": -122.14838991468913, "source_url": "https://www.cbc.ca/news/canada/edmonton/alberta-data-centres-town-halls-protests-9.7304101", "source_place": "Sturgeon County Alberta", "source_country": " Canada", "source_lat": 53.725135388664661, "source_lon": -113.69392361511744, "target_key_2": "META", "empire_frame": " Silicon Valley / US Tech", "evidence_summary": " water", "body_type": "In July, Alberta announced that the tech giant Meta is building a massive facility in Sturgeon County, north of Edmonton. The government has also said other AI data centres are in the works. Meta’s facility is set to be online in the next two to three years. ... Protesters said the community wasn’t consulted on the Meta centre, and that the government hasn’t been transparent about the others planned for the province. ... They also expressed concerns that Meta’s operation will increase their water and utility bills and create noise because these facilities use a lot of electricity and water to both power and cool hardware. Some were against the use of artificial intelligence altogether.", "source_url_2": "https://www.cbc.ca/news/canada/edmonton/alberta-data-centres-town-halls-protests-9.7304101", "year": 2026 }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.148389914689133, 37.484643850872629 ], [ -118.360484500021215, 46.032722722860051 ], [ -113.693923615117441, 53.725135388664661 ] ] ] } },
