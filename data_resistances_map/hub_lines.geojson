{ "type": "Feature", "properties": { "fid": 2, "target_key": "MICROSOFT", "target_name": "Redmond WA USA", "target_lat": 47.674, "target_lon": -122.1215, "source_url": "https://english.elpais.com/technology/2025-08-17/ais-backyard-a-map-of-the-21st-century-gold-rush.html", "source_place": "Quilicura", "source_country": "Chile", "source_lat": -33.35908071163842, "source_lon": -70.72940030449206, "target_key_2": "MICROSOFT", "empire_frame": "Silicon Valley / US tech", "evidence_summary": "Microsoft had received government clearance in 2023 for a $317-million data center in Quilicura. The company claimed its data center would have a cooling system that would eliminate the need to use water for more than half the year. In documents submitted to authorities, however, Vallejos found that Microsoft’s cooling system would rely partially on groundwater in an already water-stressed area.", "body_type": "water", "source_url_2": "https://restofworld.org/2026/ai-pushback-chile-mexico-kenya-philippines/", "year": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.1215, 47.674 ], [ -114.385209277645586, 40.594108672283859 ], [ -108.169284788555487, 33.087928826546062 ], [ -102.946857629652953, 25.311900800822166 ], [ -98.360650991499995, 17.365099815967167 ], [ -94.157874415789877, 9.315573766763428 ], [ -90.144885442747864, 1.215119322455572 ], [ -86.155881904568105, -6.891779364523392 ], [ -82.028503856050321, -14.961526615005663 ], [ -77.580294126529424, -22.945290408302846 ], [ -72.580155480054884, -30.781093657317363 ], [ -70.72940030449206, -33.35908071163842 ] ] ] } },
{ "type": "Feature", "properties": { "fid": 3, "target_key": "MICROSOFT", "target_name": "Redmond WA USA", "target_lat": 47.674, "target_lon": -122.1215, "source_url": "https://english.elpais.com/technology/2025-08-17/ais-backyard-a-map-of-the-21st-century-gold-rush.html", "source_place": "Amsterdam", "source_country": "Netherlands", "source_lat": 52.376256476946679, "source_lon": 4.8957969676833519, "target_key_2": "MICROSOFT", "empire_frame": " Silicon Valley / US Tech", "evidence_summary": "electricity", "body_type": "More than 500 people have joined a campaign to stop a huge data centre being built in Amsterdam-Zuid, arguing that it will bring “zero benefits to the area”. ... The Dutch government has introduced restrictions on the size of data centres in recent years following criticism from provincial and municipal governments about the strain on the electricity network. Data centres accounted for 4.6% of all electricity use in the Netherlands in 2024.", "source_url_2": "https://www.dutchnews.nl/2026/08/campaigners-call-for-amsterdam-to-pull-plug-on-giant-data-centre/", "year": 2026 }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.1215, 47.674 ], [ -114.01317936119203, 55.109681457327049 ], [ -102.442753847722685, 61.761372857715202 ], [ -85.417646708341337, 66.944753640468576 ], [ -62.103779813761669, 69.517815994925456 ], [ -37.06077348862874, 68.523186349786329 ], [ -17.029818947926955, 64.372261350803868 ], [ -3.224347148614171, 58.278498230813497 ], [ 4.895796967683352, 52.376256476946679 ] ] ] } },
