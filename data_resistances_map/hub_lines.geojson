{ "type": "Feature", "properties": { "target_key": "META", "target_name": "Menlo Park CA USA", "target_lat": 37.484643850872629, "target_lon": -122.14838991468913, "source_url": "https://www.theguardian.com/technology/2025/apr/27/meta-faces-ghana-lawsuits-over-impact-of-extreme-content-on-moderators", "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null, "source_place": "Accra", "source_country": " Ghana", "source_lat": 5.5531248043998529, "source_lon": -0.1969960521430312, "target_key_2": "META", "empire_frame": "US Tech", "evidence_summary": "Lawyers are gearing up for court action against a company contracted by Meta, which owns Facebook and Instagram, after meeting moderators at a facility in Ghana that is understood to employ about 150 people. ... The proposed development formed part of plans for a 174MW facility on land owned by the King David Golf Club, which could use approximately 12.05 million litres of water per dayModerators working for Majorel in Accra claim they have suffered from depression, anxiety, insomnia and substance abuse as a direct consequence of the work they do checking extreme content.", "body_type": "labor", "extraction_type": "data_labor", "source_url_2": "https://www.theguardian.com/technology/2025/apr/27/meta-faces-ghana-lawsuits-over-impact-of-extreme-content-on-moderators", "year": "2025", "image_url": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.148389914689133, 37.484643850872629 ], [ -111.410093341520692, 40.863168267870485 ], [ -99.72226017802096, 43.146776749529693 ], [ -87.393282251963257, 44.162148801233293 ], [ -74.924057951028203, 43.821738211058573 ], [ -62.862466042598292, 42.155685255889388 ], [ -51.624718588330083, 39.300369892232943 ], [ -41.405273396555302, 35.452644728484522 ], [ -32.20157129468555, 30.820929823170673 ], [ -23.891026107489083, 25.594523774082397 ], [ -16.30009317309819, 19.932694455472852 ], [ -9.245299193032778, 13.965891527095515 ],