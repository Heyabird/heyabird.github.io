{ "type": "Feature", "properties": { "target_key": "ZDATA", "target_name": "Beijing China", "target_lat": 39.902368992674347, "target_lon": 116.39166527140961, "source_url": "https://w.media/johors-data-center-protest-a-first-in-malaysia/", "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null, "source_place": "Gelang Patah", "source_country": " Malaysia", "source_lat": 1.4337897932261066, "source_lon": 103.59500428239056, "target_key_2": "ZDATA", "empire_frame": "China Tech", "evidence_summary": "A group of 50 people protested in front of a data center construction site in Gelang Patah, Johor, last Saturday, in what was described as the first such protest of its kind in Malaysia. The group, who claimed to represent 1,000 residents from four housing estates in Gelang Patah district, demanded for an end to the dust pollution allegedly caused by the construction activities, as well as compensation for their health issues arising from said activities, Bloomberg reported. Another concern was the possible impact on the residents’ water supply.", "body_type": "dust, water", "extraction_type": "data_center", "source_url_2": "https://w.media/johors-data-center-protest-a-first-in-malaysia/", "year": "2026", "image_url": "https://w.media/wp-content/uploads/2026/02/cantbreathe.jpg" }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ 116.391665271409607, 39.902368992674347 ], [ 112.781518895621161, 31.382481556334046 ], [ 109.776025805201328, 22.76661300462203 ], [ 107.129007710750258, 14.091638590511641 ], [ 104.67638344824239, 5.383539148420192 ], [ 103.595, 1.433789793226107 ] ] ] } },
{ "type": "Feature", "properties": { "target_key": "OPENAI", "target_name": "San Francisco CA USA", "target_lat": 37.770018977309682, "target_lon": -122.38900687331235, "source_url": "https://www.androidheadlines.com/2026/07/openai-stargate-michigan-data-center-backlash.html", "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null, "source_place": "Saline Michigan", "source_country": "USA", "source_lat": 42.168362559037, "source_lon": -83.780930707289414, "target_key_2": "OPENAI", "empire_frame": "US Tech", "evidence_summary": "The building of a $16 billion OpenAI and Oracle data center in Saline, Michigan, has sparked intense local protests over water usage, electrical grid reliability, and local zoning. Despite a local board trying to block the development, the consortium sued the township, forcing a settlement that allowed construction to begin. This created a rare bipartisan alliance among local voters, forcing state and federal politicians to rethink how they regulate the physical expansion of AI infrastructure.", "body_type": "water, electricity", "extraction_type": "data_center", "source_url_2": "https://www.androidheadlines.com/2026/07/openai-stargate-michigan-data-center-backlash.html", "year": "2026", "image_url": "https://www.androidheadlines.com/wp-content/uploads/2026/07/stargate-AI-data-center-project-OpenAI-2.webp" }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -122.389006873312354, 37.77 ], [ -111.343897897785709, 40.458974805503324 ], [ -99.585127737857817, 42.017923773998774 ], [ -87.479310778569513, 42.328999660661793 ], [ -83.780930707289414, 42.168362559037 ] ] ] } },
{ "type": "Feature", "properties": { "target_key": "NVIDIA", "target_name": "Santa Clara CA USA", "target_lat": 37.370022823841552, "target_lon": -121.96741781353856, "source_url": "https://missoulacurrent.com/in-oregon-suburb-data-center-boom-spurs-protests-lawsuit/", "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null, "source_place": "Hillsboro Oregon", "source_country": "USA", "source_lat": 45.520433265220859, "source_lon": -122.9844480225796, "target_key_2": "NVIDIA", "empire_frame": "US Tech", "evidence_summary": "So, too, have state tax breaks. A decades-old law meant to lure in business investment has saved data developers here around $84 million in taxes — money that might have otherwise flowed to local schools and fire departments. In March, Oregon lawmakers inadvertently set off a stampede when they passed a moratorium on these tax breaks. In the final weeks before the cutoff, officials in Hillsboro and Washington County approved 17 new data centers. ... In June, land-use nonprofit 1000 Friends of Oregon sued over those deals. They argue the flurry of data centers were greenlit without adequate public notice.", "body_type": "water, electricity", "extraction_type": "data_center", "source_url_2": "https://missoulacurrent.com/in-oregon-suburb-data-center-boom-spurs-protests-lawsuit/", "year": "2026", "image_url": "" }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -121.96741781353856, 37.370022823841552 ], [ -123.101730519479901, 46.333547661837102 ], [ -122.984448022579599, 45.520433265220859 ] ] ] } },
{ "type": "Feature", "properties": { "source_place": "Thane Maharashtra", "source_country": "India", "source_lat": 19.21114546890318, "source_lon": 72.968642425831632, "target_key": "AMAZON", "empire_frame": "US Tech", "evidence_summary": "Residents of Thane, Maharashtra, led by the 'Wake Up Thanekar' (WUT) front, are protesting Amazon Web Services' (AWS) proposed hyperscale data centre in Balkum. Their concerns include excessive water consumption, increased local temperatures due to numerous air conditioners, potential power outages, and noise pollution. Despite Amazon's assurances regarding water usage, cooling, and power, and the state government's incentives for data centres, activists fear severe environmental and social impacts. The protest has gained political support, and a committee has been formed to study the issue, highlighting growing awareness of hyperscale data centre challenges.", "body_type": "water, electricity", "extraction_type": "data_center", "source_url": "https://frontline.thehindu.com/society/why-thane-residents-are-opposing-amazon-data-centre/article71291156.ece", "year": "2026", "image_url": "https://fl-i.thgim.com/public/incoming/rmzx0s/article71301027.ece/alternates/LANDSCAPE_1200/wut-protest-data-centre.jpeg", "target_key_2": "AMAZON", "target_name": "Seattle WA USA", "target_lat": 47.622339539070765, "target_lon": -122.33942066158424, "source_url_2": "https://frontline.thehindu.com/society/why-thane-residents-are-opposing-amazon-data-centre/article71291156.ece", "year_2": null, "image_url_2": null, "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ 73.077700582211449, 19.198671640233076 ], [ 54.355927831497446, 30.530209028089789 ], [ 40.073202088294444, 37.834972342298897 ], [ 26.130541243739135, 43.995071584694841 ], [ 4.706452628934634, 50.015332979846768 ], [ -20.798414769642154, 54.189086688073132 ], [ -46.303282168218942, 56.13134460252958 ], [ -76.909123046511084, 54.977353345201166 ], [ -99.353406357258663, 52.359255952958975 ], [ -122.775531243771326, 47.675165519320721 ] ] ] } },
{ "type": "Feature", "properties": { "source_place": "Kronstorf", "source_country": "Austria", "source_lat": 48.14062434946775, "source_lon": 14.46397252933774, "target_key": "GOOGLE", "empire_frame": "US Tech", "evidence_summary": "Harald Müllner, 62, of Citizens’ Initiative Data Centre Kronstorf, which organised the demonstration, said villagers feared that, without significant scrutiny, the development would have far-reaching consequences for the area's water and energy supplies. ... 'Our aim is to gather all the facts, ensure transparency, and reveal the impacts on society, the environment and quality of life,' he said. ... More than 10,000 people have signed a petition by his organisation, demanding the public release of all contracts and agreements between Google and the local authorities.", "body_type": null, "extraction_type": "data_center", "source_url": "https://www.wsls.com/news/local/2026/07/18/botetourt-county-residents-rally-against-google-data-center-amid-national-day-of-protest/", "year": "2026", "image_url": "https://i.dailymail.com/1s/2026/07/20/10/110131363-15990271-image-a-1_1784539864169.jpg", "target_key_2": "GOOGLE", "target_name": "Mountain View CA USA", "target_lat": 37.427644980574435, "target_lon": -122.0954258034336, "source_url_2": "https://www.wsls.com/news/local/2026/07/18/botetourt-county-residents-rally-against-google-data-center-amid-national-day-of-protest/", "year_2": "2026", "image_url_2": "https://i.dailymail.com/1s/2026/07/20/10/110131363-15990271-image-a-1_1784539864169.jpg/", "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ 14.46397252933774, 48.14062434946775 ], [ 5.840773448196893, 55.379450864906509 ], [ -6.351030274026945, 61.743526978111575 ], [ -23.862915732233311, 66.514172204846361 ], [ -46.837452713148608, 68.601443231770389 ], [ -70.561169363615775, 67.255718494986851 ], [ -89.420155164941733, 62.984440908292335 ], [ -102.655492299733737, 56.899389104496535 ], [ -111.936787192488836, 49.814184562695822 ], [ -118.767617241362942, 42.170317803584929 ], [ -122.095425803433599, 37.427644980574435 ] ] ] } },
{ "type": "Feature", "properties": { "source_place": "Richmond Virginia", "source_country": "USA", "source_lat": 37.529304869866301, "source_lon": -77.461050308413888, "target_key": "GOOGLE", "empire_frame": "US Tech", "evidence_summary": "Google has pledged $4 million in community grants connected to the project. ... Hatam said that commitment falls far short of what residents deserve from a multibillion-dollar company. 'That money is not worth our health,' she said. 'It's not worth the health of our livestock, our wild population of animals, our green spaces, our water, our clean air.'", "body_type": "water, electricity", "extraction_type": "data_center", "source_url": "https://wset.com/news/local/richmond-protesters-urge-virginia-to-halt-new-data-center-approvals-statewide-botetourt-county-google-july-2026", "year": "2026", "image_url": "https://wset.com/resources/media2/16x9/2420/400/0x356/80/e4291d6e-7e8f-40f7-9144-04af8e13bf4c-processed22954A6E15E047EF8CB53C156B893163.jpeg", "target_key_2": "GOOGLE", "target_name": "Mountain View CA USA", "target_lat": 37.427644980574435, "target_lon": -122.0954258034336, "source_url_2": " https://www.reuters.com/world/asia-pacific/googles-15-billion-india-data-centre-project-battles-water-wildlife-concerns-2026-08-06/", "year_2": null, "image_url_2": null, "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -77.461050308413888, 37.529304869866301 ], [ -88.719652075442653, 39.157239548598795 ], [ -100.320560746677302, 39.65909070380421 ], [ -111.895250075075822, 38.999140340738535 ], [ -122.095425803433599, 37.427644980574435 ] ] ] } },
{ "type": "Feature", "properties": { "source_place": "Botetourt County Virginia", "source_country": "USA", "source_lat": 37.553367219693236, "source_lon": -79.78334934405018, "target_key": "GOOGLE", "empire_frame": "US Tech", "evidence_summary": "Botetourt County, Va. – Dozens of people lined Route 220 in Botetourt County Saturday, holding signs and calling attention to a Google data center planned for the area — part of a national day of protest against AI data center development. ... The demonstration was one of more than a dozen rallies held across the country, organized by the group Humans First. Similar events took place in Virginia cities including Lynchburg and Farmville, as well as in states such as Texas, Florida, California and Georgia.", "body_type": null, "extraction_type": "data_center", "source_url": "https://www.wsls.com/news/local/2026/07/18/botetourt-county-residents-rally-against-google-data-center-amid-national-day-of-protest/", "year": "2026", "image_url": null, "target_key_2": "GOOGLE", "target_name": "Mountain View CA USA", "target_lat": 37.427644980574435, "target_lon": -122.0954258034336, "source_url_2": " https://www.reuters.com/world/asia-pacific/googles-15-billion-india-data-centre-project-battles-water-wildlife-concerns-2026-08-06/", "year_2": null, "image_url_2": null, "auxiliary_storage_labeling_positionx": null, "auxiliary_storage_labeling_positiony": null }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -79.78334934405018, 37.553367219693236 ], [ -91.064257226020459, 39.053481916662861 ], [ -102.645391769011894, 39.428126024937065 ], [ -114.160517117095623, 38.650804933765805 ], [ -122.095425803433599, 37.427644980574435 ] ] ] } }

